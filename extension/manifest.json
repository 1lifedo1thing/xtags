{
  "manifest_version": 3,
  "name": "Xtags",
  "version": "0.1.0",
  "description": "在 X 时间线上，给每条帖子标出它想让你干什么。判断来自 Jev，一个只返回概率、不生成文本的模型。",
  "author": "yishan",
  "homepage_url": "https://linyishan.com",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "icons": {
    "16": "icons/on/icon16.png",
    "32": "icons/on/icon32.png",
    "48": "icons/on/icon48.png",
    "128": "icons/on/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xtags",
    "default_icon": {
      "16": "icons/on/icon16.png",
      "32": "icons/on/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
